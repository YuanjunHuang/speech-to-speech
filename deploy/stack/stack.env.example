# Central, machine-specific settings for the S2S stack. Edit this file when moving
# to another host; every launcher (restore_nuc_stack.sh, tts_supervisor.py,
# sysstats_service.py, start_s2s_gpu.sh) reads it. Environment variables override it.
#
# OpenVINO device names on this box:  GPU.0 = iGPU (never used here), GPU.1 = Arc A770.
# On an iGPU-only machine there is a single device: set these to GPU (or CPU).
ACCEL_DEVICE=GPU.1          # flow/HiFT of CosyVoice3 and any GPU-resident model
LLM_DEVICE=GPU.1            # OVMS LLM (written into its graph.pbtxt at startup)
STT_DEVICE=GPU.1            # OVMS whisper fallback (graph.pbtxt)

# OVMS LLM served on :8000 (directory under $OVMS_MODELS_DIR, same name as the model id)
LLM_MODEL=minicpm-v-4_5-int4-g-ov
OVMS_MODELS_DIR=$HOME/work/ovms/models
OVMS_STT_MODEL=whisper-small-int8-ov
OVMS_STT_DIR=$HOME/work/ovms/models_stt

# PCI address of the GPU shown in the demo's utilisation overlay; empty = auto-detect
SYSSTATS_GPU_PDEV=

# --- OVMS serving mode -------------------------------------------------------------
# native : the OVMS binary under ~/work/ovms (current NUC setup; device lives in graph.pbtxt)
# docker : openvino/model_server image as in the "Ubuntu24.04 + OVMS" guide (ovms_docker.sh);
#          the device is passed as --target_device, graph.pbtxt is not used.
OVMS_MODE=native
OVMS_IMAGE=openvino/model_server:2026.4.0-gpu
LLM_PIPELINE=                 # empty = auto: VLM_CB for IRs with a vision encoder (MiniCPM-V, Qwen3-VL), else LM_CB
LLM_PREFIX_CACHING=true          # needs the intel-igc-cm .deb (IGC_DEB, default ~/work/ovms-docker/pkgs/); false if you do not have it
LLM_EXTRA_ARGS=               # e.g. --tool_parser qwen3coder --reasoning_parser qwen3 (Qwen3 models)
